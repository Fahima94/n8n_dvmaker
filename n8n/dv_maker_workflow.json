    {
      "parameters": {
        "jsCode": "const url = $('Formulaire Entree').first().json.lien_github || '';\nconst match = url.match(/github\\.com\\/(?:[^\\/]+\\/)?([A-Za-z0-9_-]+)\\/?/);\nconst username = match ? match[1] : '';\nreturn [{ json: { github_username: username } }];"
      },
