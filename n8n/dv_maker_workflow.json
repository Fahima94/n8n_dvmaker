    },
    {
      "parameters": {
        "jsCode": "const form = $('Formulaire Entree').first().json;\nconst jobText = ($('Extraire Texte Offre').first().json.job_description || '').slice(0, 6000);\nconst cvText = ($('Extraire Texte CV').first().json.text || '').slice(0, 8000);\nlet githubSummary = '';\ntry {\n  const profile = $('Recuperer Profil GitHub').first().json;\n  const repos = $('Recuperer Repos GitHub').first().json;\n  const repoList = Array.isArray(repos) ? repos.map(r => `- ${r.name} (${r.language || 'n/a'}): ${r.description || ''}`).join('\\n') : '';\n  githubSummary = `Bio: ${profile.bio || ''}\\nDepots publics: ${profile.public_repos || 0}\\n${repoList}`;\n} catch (e) {\n  githubSummary = 'Non disponible';\n}\n\nconst profil = {\n  url_offre: form.url_offre,\n  job_offer_text: jobText,\n  donnees_perso: {\n    lien_linkedin: form.lien_linkedin || 'non fourni',\n    lien_github: form.lien_github || 'non fourni'\n  },\n  cv_brut: cvText,\n  github_resume: githubSummary\n};\n\nreturn [{ json: { jsonOutput: JSON.stringify(profil, null, 2) } }];"
      },
      "id": "c552df77-6b15-476c-a5d9-91065a04a2c1",
      "name": "Assembler Profil",
      "type": "n8n-nodes-base.code",
