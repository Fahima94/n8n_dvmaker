    {
      "parameters": {
        "promptType": "define",
        "text": "=Genere le Documentum Vitae (CV) en HTML pour ce candidat, cible sur cette offre. Competences filtrees pertinentes: {{ $json.output && $json.output.filtered_competences ? $json.output.filtered_competences : $json.output }}\n\nDonnees completes: {{ $('URL Offre + Donnees Perso + Competences').item.json.jsonOutput }}",
        "options": {
          "systemMessage": "Tu generes un CV (Documentum Vitae) compatible ATS: structure une seule colonne, sections standards (Experience, Education, Skills, Contact), texte factuel et sourced sans tournures generees par IA (evite \"oriente resultats\", \"force de proposition\"). Priorise les competences techniques transferables. Si un feedback de non-conformite est present dans les donnees d'entree, corrige le CV en consequence. Reponds uniquement avec le code HTML complet du CV."
        }
      },
      "id": "13154cb7-7eb6-4fd2-ab1a-1593d42c6680",
